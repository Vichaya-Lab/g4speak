# G4Speak Configuration
# Groq Cloud (Free API Key): https://console.groq.com/keys
GROQ_API_KEY=

# Full multilingual model for Thai and English accuracy
GROQ_STT_MODEL=whisper-large-v3
# auto for Thai/English switching; th or en for single-language dictation
GROQ_STT_LANGUAGE=auto

# Optional: Groq Cloud LLM text refinement (default: false, uses instant zero-latency rules)
GROQ_REFINER=false
